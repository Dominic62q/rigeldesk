# Public DNS name or IP address that clients will use for RigelDesk.
# Do not include a port; Compose advertises the relay on 21117.
RUSTDESK_PUBLIC_HOST=rd.example.com

# Pin this to a tested release before production. `latest` is convenient for first boot.
RUSTDESK_SERVER_IMAGE=rustdesk/rustdesk-server:latest

# Keep this directory backed up. It contains the server identity and rendezvous database.
RUSTDESK_DATA_DIR=./data
RUST_LOG=info
